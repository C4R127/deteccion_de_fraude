# Copia este archivo a .env y ajusta los valores. .env nunca se versiona.
# Son valores de desarrollo local: no reutilices contraseñas reales.

# --- PostgreSQL (superusuario del contenedor) ---
POSTGRES_USER=fraude
POSTGRES_PASSWORD=cambiar-postgres
POSTGRES_DB=fraude

# --- PostgreSQL: un usuario por servicio, dueño solo de su esquema ---
TRANSACCIONES_DB_PASSWORD=cambiar-transacciones
SCORING_DB_PASSWORD=cambiar-scoring
CASOS_DB_PASSWORD=cambiar-casos

# --- Keycloak: administrador de la consola (realm master) ---
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=cambiar-kcadmin

# --- Keycloak: usuarios de prueba del realm "fraude" (§10) ---
USUARIO_ADMIN_PASSWORD=cambiar-admin
USUARIO_SUPERVISOR_PASSWORD=cambiar-supervisor
USUARIO_ANALISTA1_PASSWORD=cambiar-analista1
USUARIO_ANALISTA2_PASSWORD=cambiar-analista2
USUARIO_AUDITOR_PASSWORD=cambiar-auditor

# --- Keycloak: cliente OAuth "generador" (client credentials, rol SISTEMA) ---
GENERADOR_CLIENT_SECRET=cambiar-secreto-generador

# --- Grafana (usuario admin, Tarea 6.5) ---
GF_SECURITY_ADMIN_PASSWORD=cambiar-grafana
